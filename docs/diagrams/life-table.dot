digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "D / E and age width" -> "qx and ax";
  "qx and ax" -> "Survivors lx and deaths dx";
  "Survivors lx and deaths dx" -> "Person-years Lx";
  "Person-years Lx" -> "Reverse total Tx";
  "Reverse total Tx" -> "Remaining expectancy Tx / lx";
}
