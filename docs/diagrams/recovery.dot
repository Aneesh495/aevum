digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "Archive truncated or changed" -> "Reject digest mismatch";
  "Failed model task" -> "Retain error and log";
  "Retain error and log" -> "Resume only under same identities";
  "Resume only under same identities" -> "Keep completed result files";
}
