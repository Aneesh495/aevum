digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "Archive bytes" -> "SHA-256 receipt";
  "SHA-256 receipt" -> "Temporary validated Parquet";
  "Temporary validated Parquet" -> "Atomic publish";
  "Frozen fit state" -> "Temporary checkpoint";
  "Temporary checkpoint" -> "Flush and atomic replace";
}
