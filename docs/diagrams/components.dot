digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "Pinned archives" -> "DuckDB + Arrow";
  "DuckDB + Arrow" -> "Python cube";
  "Python cube" -> "SciPy baselines";
  "Python cube" -> "PyTorch models";
  "PyTorch models" -> "Rust life tables";
  "Rust life tables" -> "TypeScript atlas";
}
