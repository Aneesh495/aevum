digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "Analytic integrals" -> "Native differential checks";
  "10,000 generated tables" -> "Independent recomputation";
  "Rehashed mutations" -> "Semantic rejection";
  "Saved checkpoint" -> "Fixed replay probes";
  "Browser interactions" -> "Screenshot and timing traces";
}
