digraph Aevum {
  rankdir=TB;
  graph [bgcolor="#fbfaf4", pad=.25, nodesep=.35, ranksep=.55];
  node [shape=box, style="rounded,filled", fillcolor="#eff5ed", color="#54857b", fontname="Helvetica", margin=".16,.12"];
  edge [color="#36585d"];
  "Death release + geography + sex + year + age" -> "Exact source-key match";
  "Exposure release + geography + sex + year + age" -> "Exact source-key match";
  "Exact source-key match" -> "Compatible denominator units";
  "Compatible denominator units" -> "Rate D / E";
  "Exact source-key match" -> "Explicit exclusion if incomplete";
}
